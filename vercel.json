{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/tse/:path*",
      "destination": "/api/tse?p=:path*"
    },
    {
      "source": "/cand/:path*",
      "destination": "/api/divulgacand?p=:path*"
    },
    {
      "source": "/((?!api/|tse/|cand/|geo/|data/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/geo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=2592000"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/municipios.ts": {
      "maxDuration": 60
    },
    "api/tse.ts": {
      "maxDuration": 15
    },
    "api/divulgacand.ts": {
      "maxDuration": 15
    },
    "api/votos-municipio.ts": {
      "maxDuration": 60
    }
  },
  "regions": [
    "gru1"
  ]
}
